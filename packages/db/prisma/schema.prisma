// AnimeShadow database schema.
//
// Postgres plays two roles here:
//   1. a read-through cache of anime metadata sourced from the Jikan API, so the
//      app is fast and resilient to upstream rate limits / outages, and
//   2. the system of record for everything users create — accounts and the
//      personal library (watch status, score, progress, notes).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & personal library
// ---------------------------------------------------------------------------

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  displayName   String
  passwordHash  String
  /// Set for accounts created (or ever logged in) via the Telegram Login
  /// Widget — see AuthService.loginWithTelegram. Null for email/password-only
  /// accounts.
  telegramId    String?         @unique
  username      String?         @unique
  bio           String?
  avatarUrl     String?
  accentColor   String?
  /// "light" | "dark" | "system" (next-themes) — null means never set, the
  /// client falls back to its own local preference.
  theme         String?
  onlineStatus  String          @default("OFFLINE") // ONLINE | OFFLINE | DND
  proSince      DateTime?
  /// Self-reported, set once (see profile.service.ts) — the only basis for
  /// unlocking R+-rated titles. Hentai (Rx) is excluded for everyone,
  /// verified or not; this never changes that.
  birthDate     DateTime?
  /// Up to 3 earned achievement ids shown as small circles under the
  /// avatar — order is preserved (first = leftmost). Enforced server-side
  /// in profile.service.ts, not by the DB.
  showcaseAchievementIds String[] @default([])
  /// PRO-only custom title shown next to the display name. Free text,
  /// profanity-checked server-side before it's ever saved.
  titlePrefix           String?
  /// Icon key for the title above — one of a fixed curated set, not a URL.
  titleIcon             String?
  /// How many times UserGenrePreference has been written via
  /// RecommendationService.setPreferences — capped at GENRE_PREFERENCE_MAX_SETS
  /// (initial pick + one edit), then locked. Liked titles (UserLikedAnime)
  /// have no such limit; only this explicit genre picker does.
  genrePreferencesSetCount Int @default(0)
  /// "USER" | "ADMIN" — see AuthService.ensureAdminRole (ADMIN_EMAILS env
  /// bootstrap) and the requireAdmin preHandler that gates /admin/*.
  role          String          @default("USER")
  /// Set by an admin to shut down an abusive account. Checked at login
  /// (both password and Telegram) and when creating a comment/review —
  /// not on every authenticated request, so an already-issued token keeps
  /// working for read-only browsing until it expires.
  isBanned      Boolean         @default(false)
  /// Raw `document.referrer` captured client-side at signup (see
  /// lib/visitor.ts) — feeds the admin "where did users come from" report.
  /// Null for accounts created before this existed.
  referrer      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  library       LibraryEntry[]
  reviews       Review[]
  progress      WatchProgress[]
  comments      Comment[]
  commentVotes  CommentVote[]
  sessions      WatchSession[]
  achievements  UserAchievement[]
  genrePrefs    UserGenrePreference[]
  likedAnime    UserLikedAnime[]
  pageViews     PageView[]
}

/** Genres a user explicitly picked as favourites — feeds their recommendations. */
model UserGenrePreference {
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId Int

  @@id([userId, genreId])
  @@index([genreId])
}

/// Titles a user explicitly picked as "I like this" on the recommendations
/// setup page — a stronger, more deliberate taste signal than inferring
/// genres from their library, used to derive recommendation genres when no
/// explicit UserGenrePreference exists.
model UserLikedAnime {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId   Int
  createdAt DateTime @default(now())

  @@id([userId, animeId])
  @@index([animeId])
}

/// A comment on an anime page. `mode` controls attribution: PUBLIC shows the
/// user, ANON shows "Аниме-ниндзя #<anonSeq>", SUPPORTER is a public comment
/// flagged as donator-only in the filters.
model Comment {
  id           String    @id @default(cuid())
  anime        Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId      Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     String?
  replies      Comment[] @relation("CommentReplies")
  body         String
  mode         String    @default("PUBLIC") // PUBLIC | ANON | SUPPORTER
  anonSeq      Int? // stable per (userId, animeId) once assigned
  likeCount    Int       @default(0)
  dislikeCount Int       @default(0)
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  votes        CommentVote[]

  @@index([animeId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model CommentVote {
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  value     Int // 1 | -1
  createdAt DateTime @default(now())

  @@id([commentId, userId])
}

/// One viewing session — opened on play, closed on pause / tab hide / unload.
/// Powers "current session", "most productive day" and "average per session".
model WatchSession {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  animeId   Int
  episode   Int       @default(1)
  startedAt DateTime
  endedAt   DateTime?
  seconds   Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, startedAt])
  // Backs the homepage's "trending now / this month" rails — a
  // groupBy(animeId) filtered to a recent window over the whole table, with
  // no animeId filter to narrow it first, so the range needs its own index.
  @@index([startedAt])
}

/// One SPA route visit, reported by the frontend beacon on every route
/// change (see usePageviewBeacon). `visitorId` is a random id the browser
/// keeps in localStorage — never an IP address, so anonymous traffic is
/// tracked without storing anything personally identifying. Powers the
/// admin traffic overview (volume over time, top pages, top referrers).
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  visitorId String
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}

/// An earned achievement. The catalogue itself is code-defined
/// (packages/shared achievements.ts); this table only records what a user has.
model UserAchievement {
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  @@id([userId, achievementId])
  @@index([userId])
}

/// Per-episode viewing progress, updated live from the player (roughly every
/// 15s while watching, and on pause / episode change / close). Powers
/// "continue watching" and the resume position.
model WatchProgress {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  anime           Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         Int
  episode         Int      @default(1)
  positionSeconds Int      @default(0)
  durationSeconds Int?
  completed       Boolean  @default(false)
  /// Kodik translation/voiceover id last used, if any.
  translationId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, animeId, episode])
  @@index([userId, updatedAt])
}

model Review {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId   Int
  rating    Int // 1..10
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, animeId])
  @@index([animeId, createdAt])
}

enum LibraryStatus {
  WATCHING
  PLANNED
  COMPLETED
  ON_HOLD
  DROPPED
}

model LibraryEntry {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  anime     Anime         @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId   Int
  status    LibraryStatus
  score     Int? // 1..10, user's personal rating
  progress  Int           @default(0) // episodes watched
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, animeId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Cached anime catalogue (mirrors Jikan / MyAnimeList)
// ---------------------------------------------------------------------------

enum AnimeType {
  TV
  MOVIE
  OVA
  ONA
  SPECIAL
  MUSIC
  UNKNOWN
}

enum AnimeAiring {
  AIRING
  FINISHED
  UPCOMING
  UNKNOWN
}

enum AnimeSeason {
  winter
  spring
  summer
  fall
}

model Anime {
  id              Int            @id // MyAnimeList / Shikimori id (they match)
  slug            String
  kinopoiskId     Int? // for the Alloha player provider
  title           String
  titleEnglish    String?
  titleJapanese   String?
  titleLocalized  String? // Russian title (Shikimori)
  synopsis        String?
  background      String?
  imageUrl        String?
  imageLargeUrl   String?
  bannerImage     String? // wide key-visual banner (AniList) — spotlight backdrop only
  screenshots     String[]
  type            AnimeType      @default(UNKNOWN)
  airing          AnimeAiring    @default(UNKNOWN)
  episodes        Int?
  duration        String?
  rating          String?
  source          String?
  score           Float?
  scoredBy        Int?
  rank            Int?
  popularity      Int?
  members         Int?
  favorites       Int?
  year            Int?
  season          AnimeSeason?
  airedFrom       DateTime?
  airedTo         DateTime?
  trailerEmbedUrl String?
  studios         String[]
  themes          String[]
  demographics    String[]
  genres            GenreOnAnime[]
  libraryEntries    LibraryEntry[]
  reviews           Review[]
  translations      AnimeTranslation[]
  watchAvailability WatchAvailability?
  playerSources     PlayerSource[]
  progress          WatchProgress[]
  comments          Comment[]
  likedBy           UserLikedAnime[]

  // Our own site traffic, not an upstream number — incremented once per real
  // detail-page request (see CatalogService.recordView). Feeds the future
  // admin "most viewed" report; comment counts are already fully queryable
  // via the `comments` relation, so no separate counter is needed there.
  viewCount Int @default(0)

  // Cache bookkeeping — `syncedAt` drives freshness (see ANIME_CACHE_TTL_SECONDS).
  detailSyncedAt DateTime?
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([score(sort: Desc)])
  @@index([popularity])
  @@index([rank])
  @@index([members])
  @@index([airing])
  @@index([year, season])
  @@index([viewCount(sort: Desc)])
}

/// Whether an embed player (Kodik / Alloha) has this title, cached so the
/// catalogue can badge cards without a lookup per card. `hasPlayer` null means
/// "not yet checked" or "every provider was unavailable".
model WatchAvailability {
  anime       Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId     Int      @id
  hasPlayer   Boolean?
  sourceCount Int      @default(0)
  provider    String?
  checkedAt   DateTime @default(now())

  @@index([hasPlayer])
}

/// A single playable variant (one dub/sub from one provider) for an anime.
/// Populated by the watch service so the detail page renders without a live
/// provider call.
model PlayerSource {
  anime         Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId       Int
  provider      String // "kodik" | "alloha" | "anilibria"
  sourceKey     String // translation id (kodik) or "alloha:<id>"/"anilibria:main"
  title         String
  kind          String // "voice" | "subtitles" | "unknown"
  /// "iframe" (default) or "hls" — see WatchSource in packages/shared.
  format        String   @default("iframe")
  embedUrl      String
  /// format "hls" only: JSON object, episode number string -> HLS manifest URL.
  hlsEpisodes   Json?
  quality       String?
  episodesCount Int?
  position      Int      @default(0)
  /// Reachability probe result: null = never checked, true = embed responded OK.
  stable        Boolean?
  stableAt      DateTime?
  updatedAt     DateTime @updatedAt

  @@id([animeId, provider, sourceKey])
  @@index([animeId])
}

/// Machine translations of free-text anime fields, cached forever (source text
/// doesn't change). `field` is e.g. "synopsis" | "background".
model AnimeTranslation {
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId   Int
  lang      String // BCP-47-ish: "ru"
  field     String
  value     String
  createdAt DateTime @default(now())

  @@id([animeId, lang, field])
}

model Genre {
  id        Int            @id // mal_id
  name      String         @unique
  anime     GenreOnAnime[]
  animeCount Int           @default(0)
  preferredBy UserGenrePreference[]
}

model GenreOnAnime {
  anime   Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId Int
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId Int

  @@id([animeId, genreId])
  @@index([genreId])
}
