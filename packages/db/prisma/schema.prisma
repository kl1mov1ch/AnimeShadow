// AnimeShadow database schema.
//
// Postgres plays two roles here:
//   1. a read-through cache of anime metadata sourced from the Jikan API, so the
//      app is fast and resilient to upstream rate limits / outages, and
//   2. the system of record for everything users create — accounts and the
//      personal library (watch status, score, progress, notes).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & personal library
// ---------------------------------------------------------------------------

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  displayName   String
  passwordHash  String
  /// Set for accounts created (or ever logged in) via the Telegram Login
  /// Widget — see AuthService.loginWithTelegram. Null for email/password-only
  /// accounts.
  telegramId    String?         @unique
  username      String?         @unique
  bio           String?
  avatarUrl     String?
  /// Wide picture behind the profile header. Always a file we host
  /// (/uploads/banners/...), never an outside link - see UserImageStore.
  bannerUrl     String?
  accentColor   String?
  /// "light" | "dark" | "system" (next-themes) — null means never set, the
  /// client falls back to its own local preference.
  theme         String?
  onlineStatus  String          @default("OFFLINE") // ONLINE | OFFLINE | DND
  proSince      DateTime?
  /// End of the free first month of PRO (see apps/api/src/lib/pro.ts):
  /// set at sign-up, or once on request for accounts made before the offer.
  /// Null = never had it. The second month is half price for 30 days after.
  trialUntil    DateTime?
  /// When PRO (paid, granted by an admin or earned with referrals) runs
  /// out. Null with proSince set = PRO for good. Expired PRO is cleared
  /// automatically (see apps/api/src/lib/pro.ts).
  proUntil      DateTime?
  /// The account's own invite code (8 letters/digits) — every account has
  /// one; friends type it at sign-up or come by /register?ref=CODE.
  referralCode  String?         @unique
  /// Who invited this account (their code was used at sign-up).
  referredBy    User?           @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredById  String?
  referrals     User[]          @relation("Referrals")
  referralRewards ReferralReward[]
  /// The custom nick tag, earned with referrals: worn without PRO, for good.
  titleUnlocked Boolean         @default(false)
  /// Friends added by an admin to the referral friends ladder (on top of
  /// those who really came by the code).
  bonusReferrals Int            @default(0)
  /// Profile views: unique visitors, each counted once a day (see ProfileVisit).
  profileViews  Int             @default(0)
  /// Self-reported, set once (see profile.service.ts) — the only basis for
  /// unlocking R+-rated titles. Hentai (Rx) is excluded for everyone,
  /// verified or not; this never changes that.
  birthDate     DateTime?
  /// Up to 3 earned achievement ids shown as small circles under the
  /// avatar — order is preserved (first = leftmost). Enforced server-side
  /// in profile.service.ts, not by the DB.
  showcaseAchievementIds String[] @default([])
  /// PRO-only custom title shown next to the display name. Free text,
  /// profanity-checked server-side before it's ever saved.
  titlePrefix           String?
  /// Icon key for the title above — one of a fixed curated set, not a URL.
  titleIcon             String?
  /// Experience granted by an admin on top of what the account earned — the
  /// profile level is computed from activity plus this.
  bonusXp               Int      @default(0)
  /// Earned cosmetics, both keys from the catalogues in @animeshadow/shared.
  /// The achievement each one needs is re-checked in profile.service.ts on
  /// every write, so a key here is never trusted on its own.
  avatarFrame           String?
  guessScore            GuessScore?
  /// Which profile blocks show, in what order: { order: string[], hidden: string[], autoAccent?: boolean }.
  profileLayout         Json?
  /// Up to five anime ids, in order — the "my five" showcase on the profile.
  favoriteAnimeIds      Int[]           @default([])
  /// Who sees each part of the profile: { list, stats, activity, watching } → "public" | "users" | "private".
  profilePrivacy        Json?
  profileTitle          String?
  /// How many times UserGenrePreference has been written via
  /// RecommendationService.setPreferences — capped at GENRE_PREFERENCE_MAX_SETS
  /// (initial pick + one edit), then locked. Liked titles (UserLikedAnime)
  /// have no such limit; only this explicit genre picker does.
  genrePreferencesSetCount Int @default(0)
  /// "USER" | "ADMIN" — see AuthService.ensureAdminRole (ADMIN_EMAILS env
  /// bootstrap) and the requireAdmin preHandler that gates /admin/*.
  role          String          @default("USER")
  /// Set by an admin to shut down an abusive account. Checked at login
  /// (both password and Telegram) and when creating a comment/review —
  /// not on every authenticated request, so an already-issued token keeps
  /// working for read-only browsing until it expires.
  isBanned      Boolean         @default(false)
  /// Raw `document.referrer` captured client-side at signup (see
  /// lib/visitor.ts) — feeds the admin "where did users come from" report.
  /// Null for accounts created before this existed.
  referrer      String?
  /// Set once the signup verification code is confirmed. Purely informational
  /// today — nothing in the app gates on it — see AuthService.verifyEmail.
  emailVerifiedAt DateTime?
  /// Last page opened while signed in (see AnalyticsService.record) — what
  /// the admin panel sorts and shows as "last seen".
  lastSeenAt      DateTime?
  /// Signed into every token; raised by a password reset, a password set
  /// by an admin or a ban, which ends every session the account had.
  tokenVersion    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  library       LibraryEntry[]
  reviews       Review[]
  progress      WatchProgress[]
  moments       FavoriteMoment[]
  notifications Notification[]
  comments      Comment[]
  commentVotes  CommentVote[]
  commentReports CommentReport[]
  sessions      WatchSession[]
  achievements  UserAchievement[]
  genrePrefs    UserGenrePreference[]
  likedAnime    UserLikedAnime[]
  pageViews     PageView[]
  verificationCodes VerificationCode[]
  collections        Collection[]
  collectionRatings  CollectionRating[]
  collectionComments CollectionComment[]
  /// People this account follows, and people who follow it. Two follows
  /// both ways make two friends.
  following          Follow[]        @relation("Following")
  followers          Follow[]        @relation("Followers")
  /// Posts on this account's profile wall, and posts it wrote on others'.
  wallPosts          WallPost[]      @relation("WallOwner")
  wallWritten        WallPost[]      @relation("WallAuthor")
  collectionLikes    CollectionLike[]
  collectionSaves    CollectionFavorite[]
  reportsAgainst     ProfileReport[] @relation("ReportTarget")
  reportsFiled       ProfileReport[] @relation("ReportAuthor")
  reportsHandled     ProfileReport[] @relation("ReportModerator")

  /// People search ("find friends"): trigram indexes, so a name or nick
  /// matched anywhere inside (ILIKE '%…%') is an index lookup, not a scan
  /// of every account. Needs the pg_trgm extension (see its migration).
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_displayName_trgm_idx")
  @@index([referredById])
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_username_trgm_idx")
}

/// One account following another. Mutual = friends.
model Follow {
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

/// A message left on someone's profile.
model WallPost {
  id        String    @id @default(cuid())
  owner     User      @relation("WallOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  author    User      @relation("WallAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([ownerId, createdAt])
  @@index([authorId])
}

/// A complaint about a profile — its picture, cover, name or description,
/// or how its owner behaves. Admins review them in the admin panel; one
/// decision closes every open complaint about the same profile.
model ProfileReport {
  id           String    @id @default(cuid())
  target       User      @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId     String
  reporter     User      @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId   String
  reason       String // spam | abuse | content | impersonation | other
  comment      String?
  status       String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  /// What was done: avatar | banner | bio | wall | ban.
  measures     String[]  @default([])
  note         String?
  moderator    User?     @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  moderatorId  String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetId, status])
  @@index([reporterId, targetId])
}

enum VerificationPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// A 6-digit code emailed to a user, for either confirming a new account or
/// authorising a password reset. Only the salted hash is stored — a DB dump
/// alone can't be used to complete either flow. `attempts` caps guessing: a
/// code is dead (must be re-requested) after too many wrong tries, well
/// before brute-forcing 10^6 combinations becomes remotely feasible.
model VerificationCode {
  id         String              @id @default(cuid())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  purpose    VerificationPurpose
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  // The active-code lookup for a (user, purpose) pair — issuing a new code
  // invalidates the rest, so at most one is ever unconsumed at a time.
  @@index([userId, purpose])
}

/// A signup that hasn't confirmed its email code yet — no `User` row exists
/// until it does (see AuthService.confirmRegistration). Holds everything
/// needed to create the account at that point: the password is hashed
/// already (never stored plain), so the only thing a DB dump exposes is the
/// same bcrypt hash a real account would have anyway. One row per email —
/// resubmitting the signup form just reissues the code onto the same row.
model PendingRegistration {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  passwordHash String
  referrer    String?
  /// The friend's invite code typed (or carried in the link) at sign-up.
  referralCode String?
  codeHash    String
  attempts    Int      @default(0)
  /// sha256 of the ticket /auth/register handed back: only the browser
  /// that sent these details can confirm them with the emailed code.
  ticketHash  String?
  /// Codes sent and wrong guesses made, over the row's whole life — capped,
  /// so asking for a new code never buys a fresh round of guesses.
  sends       Int      @default(1)
  failed      Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

/** Genres a user explicitly picked as favourites — feeds their recommendations. */
model UserGenrePreference {
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId Int

  @@id([userId, genreId])
  @@index([genreId])
}

/// Titles a user explicitly picked as "I like this" on the recommendations
/// setup page — a stronger, more deliberate taste signal than inferring
/// genres from their library, used to derive recommendation genres when no
/// explicit UserGenrePreference exists.
model UserLikedAnime {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId   Int
  createdAt DateTime @default(now())

  @@id([userId, animeId])
  @@index([animeId])
}

/// A comment on an anime page. `mode` controls attribution: PUBLIC shows the
/// user, ANON shows "Аниме-ниндзя #<anonSeq>", SUPPORTER is a public comment
/// flagged as donator-only in the filters.
model Comment {
  id           String    @id @default(cuid())
  anime        Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId      Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     String?
  replies      Comment[] @relation("CommentReplies")
  body         String
  mode         String    @default("PUBLIC") // PUBLIC | ANON | SUPPORTER
  anonSeq      Int? // stable per (userId, animeId) once assigned
  likeCount    Int       @default(0)
  dislikeCount Int       @default(0)
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  votes        CommentVote[]
  reports      CommentReport[]

  @@index([animeId, createdAt])
  @@index([userId])
  @@index([parentId])
}

/// A complaint about one comment; one per person per comment (a second one updates it).
model CommentReport {
  id         String   @id @default(cuid())
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId  String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String // spam | abuse | spoiler | offtopic | other
  note       String?
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime @default(now())

  @@unique([commentId, reporterId])
  @@index([status, createdAt])
}

model CommentVote {
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  value     Int // 1 | -1
  createdAt DateTime @default(now())

  @@id([commentId, userId])
}

/// One viewing session — opened on play, closed on pause / tab hide / unload.
/// Powers "current session", "most productive day" and "average per session".
model WatchSession {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  animeId   Int
  episode   Int       @default(1)
  startedAt DateTime
  endedAt   DateTime?
  seconds   Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, startedAt])
  @@index([animeId, startedAt])
  // Backs the homepage's "trending now / this month" rails — a
  // groupBy(animeId) filtered to a recent window over the whole table, with
  // no animeId filter to narrow it first, so the range needs its own index.
  @@index([startedAt])
}

/// Time with the player open, from someone who isn't signed in. Kept apart
/// from WatchSession on purpose: that table belongs to accounts (profiles,
/// hours watched, achievements) and cascades with them; this one is only
/// ever counted. `visitorId` is the same random browser id the pageview
/// beacon uses — never an IP, never tied to a person.
model GuestWatchSession {
  id        String   @id @default(cuid())
  visitorId String
  animeId   Int
  episode   Int      @default(1)
  seconds   Int
  startedAt DateTime
  createdAt DateTime @default(now())

  // Every reader filters on when the watching happened, not when the row
  // was written.
  @@index([startedAt])
  @@index([animeId, startedAt])
  @@index([visitorId, startedAt])
}

/// One SPA route visit, reported by the frontend beacon on every route
/// change (see usePageviewBeacon). `visitorId` is a random id the browser
/// keeps in localStorage — never an IP address, so anonymous traffic is
/// tracked without storing anything personally identifying. Powers the
/// admin traffic overview (volume over time, top pages, top referrers).
///
/// Written in batches (AnalyticsService) and kept for STATS_RAW_DAYS; every
/// day is rolled up into StatDay / StatDayKey before it is pruned.
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  visitorId String
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())
  /// The browser's own id for this one page view — the later "left the
  /// page" beacon finds its row by it.
  clientId    String?  @unique
  /// A run of page views with no gap over 30 minutes (kept by the browser).
  sessionId   String?
  /// The first page view of its session.
  entry       Boolean  @default(false)
  /// document.referrer when the session started (external sites only).
  sessionRef  String?
  /// mobile | tablet | desktop | bot, from the user agent.
  device      String?
  browser     String?
  os          String?
  /// The browser's language, e.g. "ru".
  lang        String?
  /// Viewport width in CSS pixels.
  screenW     Int?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// How long the page was on screen (visible), once it is left.
  durationMs  Int?

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
}

/// When each browser was first seen: one row per visitorId, written once
/// (insert-if-absent with every batch of page views). "New or returning"
/// is a key lookup here instead of a scan of everyone's whole history, and
/// it outlives the raw page views, which are pruned.
/// A browser that has been signed in, tied to that account (the latest one).
/// Visitors are counted as people through this: an account on two devices is
/// one person, a guest who signed in is a member, not a guest too.
model VisitorUser {
  visitorId String   @id
  userId    String
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VisitorFirstSeen {
  visitorId String   @id
  firstAt   DateTime

  @@index([firstAt])
}

/// One day of traffic for one audience ("registered" | "guest"), rolled up
/// from the raw tables every night (see StatsRollupService). The raw rows
/// are pruned after a while; these stay, so any past day can still be
/// looked at. Days are Moscow days; crawlers are left out.
model StatDay {
  day           DateTime @db.Date
  audience      String
  pageviews     Int      @default(0)
  visitors      Int      @default(0)
  sessions      Int      @default(0)
  bounces       Int      @default(0)
  /// Summed length of the day's sessions.
  sessionSec    Int      @default(0)
  newVisitors   Int      @default(0)
  watchSec      Int      @default(0)
  watchSessions Int      @default(0)
  /// Accounts created that day (on the "registered" row only).
  registrations Int      @default(0)

  @@id([day, audience])
}

/// The day's top keys of one kind — pages, sections, titles, sources,
/// devices… (the list is in StatsRollupService). `views` is page views
/// (for "watch": seconds watched), `uniques` distinct visitors (for
/// "watch": sessions). At most 200 keys per kind per day.
model StatDayKey {
  day     DateTime @db.Date
  dim     String
  key     String
  views   Int      @default(0)
  uniques Int      @default(0)

  @@id([day, dim, key])
  @@index([dim, day])
}

/// An earned achievement. The catalogue itself is code-defined
/// (packages/shared achievements.ts); this table only records what a user has.
model UserAchievement {
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  @@id([userId, achievementId])
  @@index([userId])
}

/// Per-episode viewing progress, updated live from the player (roughly every
/// 15s while watching, and on pause / episode change / close). Powers
/// "continue watching" and the resume position.
model WatchProgress {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  anime           Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         Int
  episode         Int      @default(1)
  positionSeconds Int      @default(0)
  durationSeconds Int?
  completed       Boolean  @default(false)
  /// Kodik translation/voiceover id last used, if any.
  translationId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, animeId, episode])
  @@index([userId, updatedAt])
}

model Review {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId   Int
  rating    Int // 1..10
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, animeId])
  @@index([animeId, createdAt])
}

enum LibraryStatus {
  WATCHING
  PLANNED
  COMPLETED
  ON_HOLD
  DROPPED
}

model LibraryEntry {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  anime     Anime         @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId   Int
  status    LibraryStatus
  score     Int? // 1..10, user's personal rating
  progress  Int           @default(0) // episodes watched
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, animeId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Cached anime catalogue (mirrors Jikan / MyAnimeList)
// ---------------------------------------------------------------------------

enum AnimeType {
  TV
  MOVIE
  OVA
  ONA
  SPECIAL
  MUSIC
  UNKNOWN
}

enum AnimeAiring {
  AIRING
  FINISHED
  UPCOMING
  UNKNOWN
}

enum AnimeSeason {
  winter
  spring
  summer
  fall
}

model Anime {
  id              Int            @id // MyAnimeList / Shikimori id (they match)
  slug            String
  kinopoiskId     Int? // for the Alloha player provider
  title           String
  titleEnglish    String?
  titleJapanese   String?
  titleLocalized  String? // Russian title (Shikimori)
  /// Other names the title goes by — Shikimori's synonyms, the licensed
  /// Russian name, abbreviations like "AoT". Searched, never shown as the name.
  titleSynonyms   String[]       @default([])
  /// When those names were last read from Shikimori; null until the first time.
  namesSyncedAt   DateTime?
  synopsis        String?
  background      String?
  imageUrl        String?
  imageLargeUrl   String?
  bannerImage     String? // wide key-visual banner (AniList) — spotlight backdrop only
  accentColor     String? // dominant colour of the cover art (AniList), as #rrggbb
  screenshots     String[]
  /// Extra frames for the guess game, fetched in the background — kept apart
  /// from `screenshots`, which the detail sync overwrites.
  gameFrames String[] @default([])
  type            AnimeType      @default(UNKNOWN)
  airing          AnimeAiring    @default(UNKNOWN)
  episodes        Int?
  duration        String?
  rating          String?
  source          String?
  score           Float?
  scoredBy        Int?
  rank            Int?
  popularity      Int?
  members         Int?
  favorites       Int?
  year            Int?
  season          AnimeSeason?
  airedFrom       DateTime?
  airedTo         DateTime?
  trailerEmbedUrl String?
  studios         String[]
  themes          String[]
  demographics    String[]
  genres            GenreOnAnime[]
  libraryEntries    LibraryEntry[]
  reviews           Review[]
  translations      AnimeTranslation[]
  watchAvailability WatchAvailability?
  playerSources     PlayerSource[]
  progress          WatchProgress[]
  comments          Comment[]
  likedBy           UserLikedAnime[]

  // Our own site traffic, not an upstream number — incremented once per real
  // detail-page request (see CatalogService.recordView). Feeds the future
  // admin "most viewed" report; comment counts are already fully queryable
  // via the `comments` relation, so no separate counter is needed there.
  viewCount Int @default(0)
  /// Per-episode titles, synopses, stills and air dates (Kitsu), as a JSON
  /// array; refreshed by `episodeInfoAt`. See EpisodeInfoService.
  episodeInfo   Json?
  episodeInfoAt DateTime?

  // Cache bookkeeping — `syncedAt` drives freshness (see ANIME_CACHE_TTL_SECONDS).
  detailSyncedAt DateTime?
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([score(sort: Desc)])
  @@index([popularity])
  @@index([rank])
  @@index([members])
  @@index([scoredBy(sort: Desc)])
  @@index([airing])
  @@index([year, season])
  @@index([viewCount(sort: Desc)])
}

/// Whether an embed player (Kodik / Alloha) has this title, cached so the
/// catalogue can badge cards without a lookup per card. `hasPlayer` null means
/// "not yet checked" or "every provider was unavailable".
/// When a background job last finished, by name ("kodik-full", "kodik-recent").
model SyncState {
  key  String   @id
  at   DateTime
  note String?
}

model WatchAvailability {
  anime       Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId     Int      @id
  hasPlayer   Boolean?
  sourceCount Int      @default(0)
  provider    String?
  /// True when at least one resolved source is a direct HLS stream (format
  /// "hls" — currently only AniLibria) rather than a third-party iframe.
  /// Its own flag rather than reading `provider` (which only ever records
  /// whichever provider resolved *first*, not "does AniLibria also have
  /// this") — a title Kodik found first but AniLibria also has would
  /// otherwise be invisible to the "own player" filter.
  hasCustomPlayer Boolean @default(false)
  /// AniLibria's own release id for this title, from its catalogue listing
  /// (see the AniLibria catalogue sync): the release is fetched by id, no
  /// name search. Null when AniLibria doesn't have the title.
  anilibriaId Int?
  checkedAt   DateTime @default(now())

  @@index([hasPlayer])
  @@index([hasCustomPlayer])
}

/// A single playable variant (one dub/sub from one provider) for an anime.
/// Populated by the watch service so the detail page renders without a live
/// provider call.
model PlayerSource {
  anime         Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId       Int
  provider      String // "kodik" | "alloha" | "anilibria"
  sourceKey     String // translation id (kodik) or "alloha:<id>"/"anilibria:main"
  title         String
  kind          String // "voice" | "subtitles" | "unknown"
  /// "iframe" (default) or "hls" — see WatchSource in packages/shared.
  format        String   @default("iframe")
  embedUrl      String
  /// format "hls" only: JSON object, episode number string -> HLS manifest URL.
  hlsEpisodes   Json?
  /// format "hls" only: episode number string -> { "480": url, "720": url,
  /// "1080": url } — every quality the provider publishes, for the player's
  /// quality menu. hlsEpisodes keeps the best one of them.
  hlsVariants   Json?
  /// format "iframe" only: JSON object, episode number string ->
  /// { url, thumbs } — the provider's own embed page for that one episode
  /// and the stills it publishes for it. Absent for providers that only
  /// hand out a single series-wide embed.
  iframeEpisodes Json?
  /// JSON object, episode number string -> { title, titleEn,
  /// durationSeconds, thumb, opening } — see WatchSource.episodeMeta.
  episodeMeta    Json?
  quality       String?
  episodesCount Int?
  position      Int      @default(0)
  /// Reachability probe result: null = never checked, true = embed responded OK.
  stable        Boolean?
  stableAt      DateTime?
  updatedAt     DateTime @updatedAt

  @@id([animeId, provider, sourceKey])
  @@index([animeId])
}

/// Machine translations of free-text anime fields, cached forever (source text
/// doesn't change). `field` is e.g. "synopsis" | "background".
model AnimeTranslation {
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId   Int
  lang      String // BCP-47-ish: "ru"
  field     String
  value     String
  createdAt DateTime @default(now())

  @@id([animeId, lang, field])
}

model Genre {
  id        Int            @id // mal_id
  name      String         @unique
  anime     GenreOnAnime[]
  animeCount Int           @default(0)
  preferredBy UserGenrePreference[]
}

/// A search someone actually made — Enter, or a result picked — for the
/// search window's "what people look for now". `who` is the account id or a
/// short hash of the address, only ever counted, so a phrase needs two
/// different people before it shows.
model SearchLog {
  id        String   @id @default(cuid())
  term      String
  who       String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([term])
}

model GenreOnAnime {
  anime   Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId Int
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId Int

  @@id([animeId, genreId])
  @@index([genreId])
}

/// "Guess the anime from a frame" on the front page — one row per player.
/// `current` is the run in progress, kept server-side so a streak can only
/// grow by answering rounds the server dealt; `best` is what the
/// leaderboard ranks.
model GuessScore {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @id
  best      Int      @default(0)
  current   Int      @default(0)
  played    Int      @default(0)
  bestAt    DateTime?
  /// This player's own order through the frame deck (see games route), and
  /// how far into it they are. A frame comes round again only after the
  /// whole deck has been dealt.
  deckSeed  Int?
  deckPos   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([best])
}

/// A user's collection: a titled article about a set of anime — text and
/// anime cards interleaved (`blocks`), picked criteria (`tags`), rated and
/// commented on by others. Free accounts keep up to three; PRO, any number.
model Collection {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  title        String
  summary      String   @default("")
  /// [{ type: "text", text } | { type: "anime", animeId, note }]
  blocks       Json
  tags         String[] @default([])
  /// The anime in `blocks`, in order — for the cover and for search.
  animeIds     Int[]    @default([])
  published    Boolean  @default(true)
  /// list | ranked | grid
  layout       String   @default("list")
  /// One of the palette's colours, or none.
  accent       String?
  allowComments Boolean @default(true)
  likeCount    Int      @default(0)
  viewCount    Int      @default(0)
  ratingSum    Int      @default(0)
  ratingCount  Int      @default(0)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratings  CollectionRating[]
  comments CollectionComment[]
  views    CollectionView[]
  likes    CollectionLike[]
  savedBy  CollectionFavorite[]

  @@index([userId, createdAt])
  @@index([published, createdAt])
  @@index([published, ratingSum])
  @@index([published, viewCount])
}

/// A heart on a collection: one per person.
model CollectionLike {
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime   @default(now())

  @@id([collectionId, userId])
  @@index([userId])
}

/// A collection someone keeps for later — their "saved" list.
model CollectionFavorite {
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime   @default(now())

  @@id([collectionId, userId])
  @@index([userId, createdAt])
}

model CollectionRating {
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  /// 1–10
  value        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@id([collectionId, userId])
}

model CollectionComment {
  id           String     @id @default(cuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  body         String
  /// The comment this one answers, if any — one level of threads.
  parent       CollectionComment?  @relation("CollectionCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  parentId     String?
  replies      CollectionComment[] @relation("CollectionCommentReplies")
  /// The exact comment answered (may be a reply inside the thread).
  replyToId    String?
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@index([collectionId, createdAt])
  @@index([parentId])
}

/// One row per visitor per day per collection — the stats page counts
/// these; `Collection.viewCount` is the running total.
model CollectionView {
  id           String     @id @default(cuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  visitorId    String
  userId       String?
  day          DateTime   @db.Date
  createdAt    DateTime   @default(now())

  @@unique([collectionId, visitorId, day])
  @@index([collectionId, day])
  // Achievements count one account's views.
  @@index([userId])
}

/// A referral reward an account has taken (see packages/shared/src/referral.ts
/// for the ladder). One row per reward, so none can be taken twice.
model ReferralReward {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rewardId  String
  claimedAt DateTime @default(now())

  @@id([userId, rewardId])
}

/// Who looked at a profile lately — only to count each visitor once a day.
/// Rows older than two days are swept away; the total lives on
/// User.profileViews, so showing it never counts anything.
model ProfileVisit {
  profileId String
  /// The viewer's account id, or "v:<visitor id>" for a guest.
  viewerKey String
  lastAt    DateTime @default(now())

  @@id([profileId, viewerKey])
  @@index([lastAt])
}

/// A favourite moment: an episode at a second, with the dub it was watched
/// in and a few words — up to five per account, shown on the profile beside
/// the favourite five.
model FavoriteMoment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  animeId   Int
  episode   Int
  seconds   Int
  dub       String?
  note      String?
  /// Order on the profile, 0 first.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, position])
}

/// The newest episode a title is known to have — what a new one is
/// measured against. Written by the Kodik checks (see NotificationService).
model EpisodeMark {
  animeId   Int      @id
  latest    Int
  updatedAt DateTime @updatedAt
}

/// Something to tell an account: for now, new episodes of a title in its list.
model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      String    @default("episode")
  animeId   Int
  /// The newest episode out; `fromEpisode` the first new one when several came at once.
  episode   Int
  fromEpisode Int?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([userId, animeId, episode])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}
