{
  "name": "@animeshadow/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "prisma", "src/generated"],
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-generated.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "push": "dotenv -e ../../.env -- prisma db push",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "grant-pro": "dotenv -e ../../.env -- node scripts/grant-all-pro.mjs",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@animeshadow/shared": "workspace:*",
    "@prisma/adapter-pg": "^6.3.0",
    "@prisma/client": "^6.3.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@animeshadow/shikimori": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
