animeshadow.online {
	encode zstd gzip

	# robots.txt, the sitemaps and the IndexNow key file are built by the API
	# (routes/seo.ts), so they always match the catalogue and the domain.
	@seofiles path /robots.txt /sitemap.xml /sitemap-*.xml /indexnow-*.txt
	handle @seofiles {
		rewrite * /api/seo-files{path}
		reverse_proxy 127.0.0.1:4000
	}

  @tv path /tv /tv/*
  handle @tv {
    rewrite * /api{uri}
    reverse_proxy 127.0.0.1:4000
  }

  @backend path /api/* /uploads/*
	handle @backend {
		reverse_proxy 127.0.0.1:4000
	}

	handle {
		root * /var/www/animeshadow/apps/web/dist

		# Real files — the hashed scripts and styles, icons, the service
		# worker, the manifest — straight from disk.
		@file {
			file
			not path / /index.html
		}
		handle @file {
			# Hashed build output never changes under the same name: the
			# browser keeps it for a year and never asks again.
			@immutable path /assets/*
			header @immutable Cache-Control "public, max-age=31536000, immutable"
			# Everything else is re-checked on every load, or a deploy would
			# keep showing the old app to anyone who had it cached.
			@entry not path /assets/*
			header @entry Cache-Control "no-cache"
			# deploy.sh writes .br/.gz next to every text file, so they are
			# sent as they are instead of compressed on every request.
			file_server {
				precompressed br gzip
			}
		}

		# Every page (any other address): the same app, but with that page's
		# own title, description, structured data and readable content filled
		# in by the API — what search engines read. If the API answers with an
		# error, the bare app shell is served instead, and it still works.
		handle {
			rewrite * /api/seo/page{uri}
			reverse_proxy 127.0.0.1:4000 {
				# An error, or an answer that isn't a page at all (an API from
				# before this existed answers JSON): the bare shell instead.
				@broken status 5xx
				handle_response @broken {
					root * /var/www/animeshadow/apps/web/dist
					rewrite * /index.html
					header Cache-Control "no-cache"
					file_server
				}
				@notpage header Content-Type application/json*
				handle_response @notpage {
					root * /var/www/animeshadow/apps/web/dist
					rewrite * /index.html
					header Cache-Control "no-cache"
					file_server
				}
			}
		}
	}

	# The API not running at all (a restart): pages still get the app shell.
	handle_errors {
		@unavailable expression `{err.status_code} in [502, 503, 504]`
		handle @unavailable {
			root * /var/www/animeshadow/apps/web/dist
			rewrite * /index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
}

# The www host exists in DNS, so it has to answer - as a redirect, not as a
# second copy of the site: one canonical origin keeps sessions, the service
# worker and every absolute link in one place.
www.animeshadow.online {
	redir https://animeshadow.online{uri} permanent
}
