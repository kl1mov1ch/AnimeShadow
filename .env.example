# ---------------------------------------------------------------------------
# Copy this file to .env and adjust as needed:  cp .env.example .env
# The same .env at the repo root is read by docker compose, Prisma and the API.
# ---------------------------------------------------------------------------

# Postgres (matches docker-compose.yml)
POSTGRES_USER=animeshadow
POSTGRES_PASSWORD=animeshadow
POSTGRES_DB=animeshadow
POSTGRES_PORT=5433

# Connection string used by Prisma + the API
DATABASE_URL="postgresql://animeshadow:animeshadow@localhost:5433/animeshadow?schema=public"

# API server
API_PORT=4000
API_HOST=0.0.0.0
# NODE_ENV is set by the API's own start scripts — don't set it here, or Vite
# will pick it up and build the frontend in development mode.

# Auth — generate your own: `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS — comma separated list of allowed origins for the browser app
CORS_ORIGINS=http://localhost:5173

# Upstream anime data source
# How long (seconds) a cached anime row is considered fresh before re-fetching
ANIME_CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Localisation — translating English text from upstream sources to Russian
# ---------------------------------------------------------------------------
# Russian titles + synopses come from Shikimori (human-written) first, then
# fall back to machine translation (Google, then MyMemory — both keyless).
# Every result is cached in Postgres forever.
TRANSLATE_ENABLED=true
# Optional: your email lifts the MyMemory anonymous quota (5k -> 50k words/day)
MYMEMORY_EMAIL=

# ---------------------------------------------------------------------------
# Custom video player: direct HLS from Kodik, AniLibria and configured feeds.
# The API resolves playlists; the browser downloads video from provider CDNs.
# Setup and diagnostics: docs/kodik-direct-links.md and docs/player-sources.md.
# ---------------------------------------------------------------------------
# Kodik aggregates anime with many RU dubs + subs. Free token: https://kodik.cc
KODIK_API_TOKEN=
# Legacy metadata fallback. Iframe-only sources are not exposed by the
# custom-only watch API; add direct HLS feeds below instead.
WATCH_EMBED_TEMPLATE=

# Additional direct HLS providers. Each URL is your provider's JSON endpoint;
# it receives {malId} and returns the contract in docs/player-sources.md.
# Secrets stay in a separate env variable named by tokenEnv.
WATCH_DIRECT_PROVIDERS=[]
# Example (configure real endpoints and stream hosts before enabling):
# WATCH_DIRECT_PROVIDERS=[{"id":"partner","urlTemplate":"https://api.example.com/anime/{malId}","tokenEnv":"PARTNER_TOKEN","streamHosts":["cdn.example.com"]}]

# Number of unique anime cards to import with pnpm catalog:expand.
BULK_SEED_TARGET=15000

# ---------------------------------------------------------------------------
# "Sign in with Telegram" — optional. Create a bot via @BotFather (/newbot),
# then point it at your domain with /setdomain. Leave empty to hide the
# Telegram button entirely; nothing else about auth depends on it.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# The same bot sends new-episode messages and reads /start, /stop by long polling.
# Unset = only in production; "false" on a second production copy of the API.
TELEGRAM_BOT_POLLING=
# Only if the server can't reach api.telegram.org: your own reverse proxy of the Bot API.
TELEGRAM_API_URL=
# Browser push: generate once with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@animeshadow.online

# ---------------------------------------------------------------------------
# Search by frame (trace.moe). Optional. Without a key the free tier allows
# 100 searches a month per IP and one at a time — and on a server every
# visitor shares the server's one IP, so that is 100 a month for the whole
# site. Check what the server has left with:  curl https://api.trace.moe/me
# ---------------------------------------------------------------------------
TRACE_MOE_API_KEY=

# ---------------------------------------------------------------------------
# Transactional email (Resend: https://resend.com, free tier is plenty) —
# powers the signup verification code and "forgot password" reset code.
# Leave RESEND_API_KEY empty and codes are printed to the API's console
# instead of emailed — signup and password reset both still work end-to-end.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
#
# The shared onboarding sender below is NOT just "lower deliverability": Resend
# refuses it for every recipient except the address that owns the Resend
# account. Leave it as-is and signup codes will arrive for you and for nobody
# else — which looks exactly like the feature being broken. Verify a domain and
# change this before letting real users register.
EMAIL_FROM=AnimeShadow <onboarding@resend.dev>
# Temporarily allow registration without an emailed code.
EMAIL_VERIFICATION_REQUIRED=false
# Optional manual verification row in profile (hidden in temporary signup mode).
VITE_EMAIL_VERIFICATION_REQUIRED=false
# Public URL of the site — the one-click "confirm" / "reset password" buttons
# in those emails link here. No trailing slash. Production: https://animeshadow.online
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Comma-separated emails to promote to the admin role (/admin) the next time
# that account logs in or loads /auth/me. Leave empty and no one gets admin.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Prometheus metrics (GET /metrics). Leave METRICS_TOKEN empty in dev — the
# endpoint stays open. Set it in production and pass the same value as
# `Authorization: Bearer <token>` (or ?token=) when scraping, or the
# endpoint returns 401 — it exposes operational detail (route latencies,
# aggregate watch-time) you don't want on the open internet.
# ---------------------------------------------------------------------------
METRICS_TOKEN=
# Where the admin dashboard's "Monitoring" tab reads from. Start it with
#   sh deploy/prometheus/write-token.sh && docker compose up -d prometheus
PROMETHEUS_URL=http://127.0.0.1:9090

# ---------------------------------------------------------------------------
# Frontend (apps/web) — Vite only exposes vars prefixed with VITE_
# ---------------------------------------------------------------------------
# Leave empty in development: the Vite dev server proxies /api to the API.
# Set to the API's public URL only when the frontend is hosted separately.
# Absolute origin of the site, used for canonical links and share cards.
# Empty falls back to whatever host the page was opened on.
# Production: https://animeshadow.online
VITE_SITE_URL=

VITE_API_URL=

# Third-party analytics (all optional). The counters load in the browser
# only after the visitor accepts cookies. VITE_* values go into the web
# build, so set them before deploying.
#   Yandex Metrica: counter id; YM_OAUTH_TOKEN (secret, server only) also
#   shows Metrica's own summary in the admin's Analytics tab.
VITE_YM_ID=
YM_OAUTH_TOKEN=
#   Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
VITE_GA_ID=
#   Umami (self-hosted or cloud): script URL, website id, dashboard link
VITE_UMAMI_SRC=
VITE_UMAMI_ID=
UMAMI_DASHBOARD_URL=

# SEO. Codes from Yandex Webmaster / Google Search Console / Bing Webmaster
# ("подтвердить права" → meta tag): only the content="…" value. They go into
# the head of every page the API renders.
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
BING_VERIFICATION=
# IndexNow key (8–128 letters/digits, e.g. `openssl rand -hex 16`): new and
# changed pages are announced to Yandex and Bing daily. Empty = off.
INDEXNOW_KEY=
# Where the built web app is (its index.html is the page template). Default:
# ../web/dist relative to the API's working directory.
WEB_DIST_DIR=

# Optional Mulen Pay. Off until merchant keys, RUB prices and a test payment are verified.
MULENPAY_ENABLED=false
# Omit MULENPAY_SHOP_ID until configured (a positive integer, never a frontend variable).
# MULENPAY_SHOP_ID=123
MULENPAY_API_KEY=
MULENPAY_SECRET_KEY=
# Approved RUB amounts by existing subscription length; no automatic USD conversion.
MULENPAY_PRICES_RUB={}

# Short, muted homepage clips; requires an available ffmpeg binary.
HERO_CLIPS_ENABLED=true
