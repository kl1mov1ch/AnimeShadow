# ---------------------------------------------------------------------------
# Copy this file to .env and adjust as needed:  cp .env.example .env
# The same .env at the repo root is read by docker compose, Prisma and the API.
# ---------------------------------------------------------------------------

# Postgres (matches docker-compose.yml)
POSTGRES_USER=animeshadow
POSTGRES_PASSWORD=animeshadow
POSTGRES_DB=animeshadow
POSTGRES_PORT=5433

# Connection string used by Prisma + the API
DATABASE_URL="postgresql://animeshadow:animeshadow@localhost:5433/animeshadow?schema=public"

# API server
API_PORT=4000
API_HOST=0.0.0.0
# NODE_ENV is set by the API's own start scripts — don't set it here, or Vite
# will pick it up and build the frontend in development mode.

# Auth — generate your own: `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS — comma separated list of allowed origins for the browser app
CORS_ORIGINS=http://localhost:5173

# Upstream anime data source
JIKAN_BASE_URL=https://api.jikan.moe/v4
# How long (seconds) a cached anime row is considered fresh before re-fetching
ANIME_CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Localisation — translating Jikan's English text to Russian
# ---------------------------------------------------------------------------
# Russian titles + synopses come from Shikimori (human-written) first, then
# fall back to machine translation (Google, then MyMemory — both keyless).
# Every result is cached in Postgres forever.
TRANSLATE_ENABLED=true
# Optional: your email lifts the MyMemory anonymous quota (5k -> 50k words/day)
MYMEMORY_EMAIL=

# ---------------------------------------------------------------------------
# Video player (the "Watch" tab). Optional — leave both empty and the tab
# falls back to the trailer. The app never hosts video; it embeds a URL from
# whichever provider you configure.
# ---------------------------------------------------------------------------
# Kodik aggregates anime with many RU dubs + subs. Free token: https://kodik.cc
KODIK_API_TOKEN=
# ...or any iframe URL with a {malId} placeholder (Alloha, VideoCDN, your own):
#   WATCH_EMBED_TEMPLATE=https://example.tv/embed?mal_id={malId}
WATCH_EMBED_TEMPLATE=

# ---------------------------------------------------------------------------
# "Sign in with Telegram" — optional. Create a bot via @BotFather (/newbot),
# then point it at your domain with /setdomain. Leave empty to hide the
# Telegram button entirely; nothing else about auth depends on it.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Search by frame (trace.moe). Optional. Without a key the free tier allows
# 100 searches a month per IP and one at a time — and on a server every
# visitor shares the server's one IP, so that is 100 a month for the whole
# site. Check what the server has left with:  curl https://api.trace.moe/me
# ---------------------------------------------------------------------------
TRACE_MOE_API_KEY=

# ---------------------------------------------------------------------------
# Transactional email (Resend: https://resend.com, free tier is plenty) —
# powers the signup verification code and "forgot password" reset code.
# Leave RESEND_API_KEY empty and codes are printed to the API's console
# instead of emailed — signup and password reset both still work end-to-end.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
#
# The shared onboarding sender below is NOT just "lower deliverability": Resend
# refuses it for every recipient except the address that owns the Resend
# account. Leave it as-is and signup codes will arrive for you and for nobody
# else — which looks exactly like the feature being broken. Verify a domain and
# change this before letting real users register.
EMAIL_FROM=AnimeShadow <onboarding@resend.dev>
# Public URL of the site — the one-click "confirm" / "reset password" buttons
# in those emails link here. No trailing slash. Production: https://fiat-legacy.xyz
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Comma-separated emails to promote to the admin role (/admin) the next time
# that account logs in or loads /auth/me. Leave empty and no one gets admin.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Prometheus metrics (GET /metrics). Leave METRICS_TOKEN empty in dev — the
# endpoint stays open. Set it in production and pass the same value as
# `Authorization: Bearer <token>` (or ?token=) when scraping, or the
# endpoint returns 401 — it exposes operational detail (route latencies,
# aggregate watch-time) you don't want on the open internet.
# ---------------------------------------------------------------------------
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Frontend (apps/web) — Vite only exposes vars prefixed with VITE_
# ---------------------------------------------------------------------------
# Leave empty in development: the Vite dev server proxies /api to the API.
# Set to the API's public URL only when the frontend is hosted separately.
VITE_API_URL=
