{
  "name": "animeshadow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @animeshadow/db generate",
    "db:migrate": "pnpm --filter @animeshadow/db migrate",
    "db:seed": "pnpm --filter @animeshadow/db seed",
    "db:grant-pro": "pnpm --filter @animeshadow/db grant-pro",
    "db:studio": "pnpm --filter @animeshadow/db studio",
    "packages:build": "pnpm --filter \"./packages/*\" -r build",
    "setup": "pnpm install && pnpm db:up && pnpm db:generate && pnpm packages:build && pnpm db:migrate && pnpm db:seed",
    "predev": "pnpm db:generate && pnpm packages:build",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @animeshadow/api dev",
    "dev:web": "pnpm --filter @animeshadow/web dev",
    "build": "pnpm db:generate && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
